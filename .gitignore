# ─── Dependencies ────────────────────────────────────────────
node_modules/
# Bun is the package manager: other lockfiles must never be committed
package-lock.json
yarn.lock
pnpm-lock.yaml

# ─── Expo ────────────────────────────────────────────────────
.expo/
dist/
web-build/
expo-env.d.ts

# Native folders are generated by Expo (Continuous Native Generation)
/ios
/android

# Native signing material
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# ─── Environment & secrets ───────────────────────────────────
# Real keys stay local; .env.example (empty template) is committed
.env
.env*.local
.env.keys

# ─── Supabase (local CLI state, contains local secrets) ──────
supabase/.branches/
supabase/.temp/
supabase/.env

# ─── TypeScript / tests ──────────────────────────────────────
*.tsbuildinfo
coverage/

# ─── Logs ────────────────────────────────────────────────────
npm-debug.*
yarn-debug.*
yarn-error.*
*.log

# ─── OS files ────────────────────────────────────────────────
.DS_Store
Thumbs.db

# ─── Editors / tools ─────────────────────────────────────────
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.claude/settings.local.json
